{
  "name": "nexora",
  "private": true,
  "description": "Gestión de proyectos de Neri + monorepo de sitios de clientes (apps/, packages/)",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start": "node server.js",
    "build:apps": "turbo run build",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "vitest run && turbo run typecheck build"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "turbo": "^2",
    "typescript": "^5",
    "vitest": "^3"
  },
  "engines": { "node": ">=20" },
  "packageManager": "npm@10.9.0"
}
